<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, user-scalable=no">
<title>Умный сад</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
:root{
  --bg:#f4f7f1;--card:#ffffff;--ink:#1c2a1f;--muted:#66736a;--line:#e1e8dd;
  --accent:#2f8f4e;--accent-ink:#ffffff;--accent-soft:#e3f3e7;
  --warn:#8a5a0b;--warn-soft:#fdf1d6;
  --shadow:0 1px 2px rgba(20,40,25,.06),0 6px 20px rgba(20,40,25,.07);
}
:root[data-theme="dark"]{
  --bg:#121a14;--card:#1b261e;--ink:#eaf2ec;--muted:#93a498;--line:#2a3a2f;
  --accent:#4cc275;--accent-ink:#0c1a11;--accent-soft:#1f3a29;
  --warn:#e8c070;--warn-soft:#3a3220;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 6px 20px rgba(0,0,0,.25);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--bg);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  font-size:16px;line-height:1.45}
#app{max-width:560px;margin:0 auto;padding:16px 16px calc(112px + env(safe-area-inset-bottom))}
h1{font-size:28px;line-height:1.15;margin:0 0 8px;letter-spacing:-.02em}
h2{font-size:22px;line-height:1.2;margin:0 0 6px;letter-spacing:-.01em}
h3{font-size:17px;margin:20px 0 8px}
p{margin:0 0 10px}
.sub{color:var(--muted);margin:0 0 18px}
.muted{color:var(--muted)}
.small{font-size:13px}

.progress{display:flex;gap:6px;margin:2px 0 6px}
.progress i{flex:1;height:5px;border-radius:3px;background:var(--line)}
.progress i.on{background:var(--accent)}
.stepno{font-size:13px;color:var(--muted);margin-bottom:14px}

.bar{position:fixed;left:0;right:0;bottom:0;z-index:5;
  padding:14px 16px calc(12px + env(safe-area-inset-bottom));
  background:linear-gradient(to top,var(--bg) 72%,transparent)}
.bar .btn{display:block;width:100%;max-width:528px;margin:0 auto}
.btn{border:0;border-radius:14px;padding:15px 18px;font-weight:600;font-size:16px;font-family:inherit;
  background:var(--accent);color:var(--accent-ink);cursor:pointer;text-align:center}
.btn:disabled{opacity:.4;cursor:default}
.btn.ghost{background:var(--card);color:var(--ink);border:1px solid var(--line)}
.btns{display:grid;gap:10px;margin-top:20px}

.hero-intro{background:linear-gradient(135deg,#2f8f4e,#7bc47f);color:#fff;border-radius:22px;padding:26px 22px;margin-bottom:18px}
.hero-intro .big{font-size:54px;line-height:1;margin-bottom:10px}
.hero-intro h1{color:#fff}
.hero-intro p{color:rgba(255,255,255,.92);margin:0}
.flow{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.flow li{display:flex;gap:12px;align-items:flex-start;background:var(--card);border-radius:14px;padding:12px 14px;box-shadow:var(--shadow)}
.flow .n{flex:none;width:28px;height:28px;border-radius:50%;background:var(--accent-soft);color:var(--accent);
  font-weight:700;display:grid;place-items:center;font-size:14px}
.flow b{display:block}
.flow span{color:var(--muted);font-size:14px}

.opts{display:grid;gap:10px}
.opt{display:flex;gap:14px;align-items:center;width:100%;padding:14px;border:2px solid transparent;border-radius:16px;
  background:var(--card);box-shadow:var(--shadow);cursor:pointer;text-align:left;color:inherit;font:inherit}
.opt.sel{border-color:var(--accent);background:var(--accent-soft)}
.opt .ic{font-size:30px;flex:none;width:40px;text-align:center}
.opt b{display:block;font-size:17px}
.opt span{color:var(--muted);font-size:14px}

.search{width:100%;padding:13px 14px;border-radius:14px;border:1px solid var(--line);background:var(--card);
  color:var(--ink);font:inherit;margin-bottom:10px}
.city{display:flex;justify-content:space-between;align-items:center;gap:10px;width:100%;padding:13px 14px;margin-bottom:8px;
  border:2px solid transparent;border-radius:14px;background:var(--card);color:inherit;font:inherit;cursor:pointer;text-align:left}
.city small{color:var(--muted)}
.city.sel{border-color:var(--accent);background:var(--accent-soft)}
.climates{display:grid;gap:8px;margin:0 0 10px 12px}
.info{background:var(--accent-soft);border-radius:14px;padding:12px 14px;margin-bottom:12px;font-size:14px}
.info b{font-size:16px}

.areabox{display:flex;gap:10px}
.areabox input,.areabox select{padding:14px;border-radius:14px;border:1px solid var(--line);background:var(--card);color:var(--ink);font:inherit;font-size:20px}
.areabox input{flex:1;min-width:0;font-weight:600}
.areabox select{font-size:16px}
.hint{margin:10px 2px 14px;color:var(--muted);font-size:14px;min-height:21px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:9px 14px;font:inherit;font-size:15px;cursor:pointer}

.work{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:12px}
.work li{display:flex;gap:12px;align-items:center;background:var(--card);border-radius:14px;padding:14px;box-shadow:var(--shadow);opacity:.45;transition:opacity .3s}
.work li.act,.work li.done{opacity:1}
.work .dot{flex:none;width:22px;height:22px;border-radius:50%;border:3px solid var(--line)}
.work li.act .dot{border-color:var(--accent);border-top-color:transparent;animation:spin .8s linear infinite}
.work li.done .dot{border-color:var(--accent);background:var(--accent);animation:none;position:relative}
.work li.done .dot::after{content:"";position:absolute;left:5px;top:1px;width:5px;height:10px;border:solid var(--accent-ink);border-width:0 2px 2px 0;transform:rotate(45deg)}
@keyframes spin{to{transform:rotate(360deg)}}

.summary{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 16px}
.tag{background:var(--card);border:1px solid var(--line);border-radius:999px;padding:4px 10px;font-size:13px;color:var(--muted)}
.hero{display:block;width:100%;text-align:left;border:0;color:inherit;font:inherit;cursor:pointer;
  background:var(--card);border-radius:22px;padding:18px;box-shadow:var(--shadow);margin-bottom:12px;
  outline:2px solid var(--accent)}
.badge{display:inline-block;background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:3px 10px;font-size:12px;font-weight:700;margin-bottom:12px}
.row{display:flex;gap:14px;align-items:center}
.row .big{font-size:46px;line-height:1}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}
.stats div{background:var(--bg);border-radius:12px;padding:9px 8px}
.stats b{display:block;font-size:15px;line-height:1.2}
.stats span{font-size:12px;color:var(--muted)}
.warnline{margin-top:10px;background:var(--warn-soft);color:var(--warn);border-radius:10px;padding:8px 10px;font-size:13px}
.more{display:flex;gap:12px;align-items:center;width:100%;text-align:left;border:0;color:inherit;font:inherit;cursor:pointer;
  background:var(--card);border-radius:16px;padding:12px 14px;box-shadow:var(--shadow);margin-bottom:10px}
.more .em{font-size:30px}
.more .grow{flex:1;min-width:0}
.more b{display:block}
.more span.s{color:var(--muted);font-size:13px;display:block}
.pct{font-weight:700;color:var(--accent)}

.back{border:0;background:none;color:var(--accent);font:inherit;font-weight:600;padding:4px 0 12px;cursor:pointer}
.dhead{display:flex;gap:14px;align-items:center;margin-bottom:10px}
.dhead .big{font-size:54px;line-height:1}
.why{background:var(--accent-soft);border-radius:16px;padding:12px 14px;margin:14px 0}
.why ul{margin:6px 0 0;padding-left:18px}
.why li{margin-bottom:3px}
.tabs{display:flex;gap:4px;background:var(--line);padding:4px;border-radius:14px;margin:14px 0}
.tabs button{flex:1;border:0;background:none;color:var(--muted);font:inherit;font-size:13px;font-weight:600;padding:9px 2px;border-radius:10px;cursor:pointer}
.tabs button.on{background:var(--card);color:var(--ink);box-shadow:0 1px 3px rgba(0,0,0,.12)}
.panel{background:var(--card);border-radius:16px;padding:16px;box-shadow:var(--shadow)}
.panel ul.plain{margin:0;padding-left:18px}
.panel ul.plain li{margin-bottom:8px}
.eq{list-style:none;margin:0;padding:0}
.eq li{padding:10px 0;border-bottom:1px solid var(--line)}
.eq li:last-child{border:0}
.eq b{display:block}
.eq span{color:var(--muted);font-size:14px}
.st{list-style:none;margin:0;padding:0;counter-reset:s}
.st li{position:relative;padding:0 0 16px 40px}
.st li::before{counter-increment:s;content:counter(s);position:absolute;left:0;top:0;width:28px;height:28px;border-radius:50%;
  background:var(--accent);color:var(--accent-ink);font-weight:700;display:grid;place-items:center;font-size:14px}
.st b{display:block;margin-bottom:2px}
.st span{color:var(--muted)}
.tip{background:var(--warn-soft);color:var(--warn);border-radius:12px;padding:10px 12px;font-size:14px;margin-top:6px}
table.t{width:100%;border-collapse:collapse}
table.t td{padding:9px 0;border-bottom:1px solid var(--line);vertical-align:top}
table.t td:last-child{text-align:right;font-weight:600;padding-left:12px}
table.t tr:last-child td{border:0}
table.t tr.total td{font-size:17px;color:var(--accent)}
.foot{margin-top:16px;font-size:12px;color:var(--muted)}

/* ===== v2: категории, карточка, платный план ===== */
.c-greens{--g1:#2f8f4e;--g2:#8fd18a}
.c-veg{--g1:#d9622b;--g2:#f2b45a}
.c-decor{--g1:#b64a8f;--g2:#f0a3c8}
.c-trees{--g1:#2a7a74;--g2:#86c9a2}
.grad{background:linear-gradient(135deg,var(--g1),var(--g2));color:#fff}
.ico{flex:none;vertical-align:middle}
.chip.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:600}
.catrow{display:flex;gap:8px;overflow-x:auto;margin:6px -16px 14px;padding:2px 16px 6px;scrollbar-width:none}
.catrow::-webkit-scrollbar{display:none}
.catrow .chip{flex:none;white-space:nowrap}
.listhead{display:flex;justify-content:space-between;align-items:baseline;margin:20px 0 4px}
.listhead h3{margin:0}
.thumb{flex:none;width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:26px}

/* верхняя карточка результата */
.top{display:block;width:100%;text-align:left;border:0;font:inherit;cursor:pointer;border-radius:24px;padding:18px;margin-bottom:6px;
  box-shadow:var(--shadow);position:relative;overflow:hidden}
.top .badge{background:rgba(255,255,255,.22);color:#fff;margin-bottom:14px}
.top .lockpill{position:absolute;right:14px;top:14px;display:flex;gap:5px;align-items:center;font-size:12px;font-weight:600;
  background:rgba(0,0,0,.2);border-radius:999px;padding:4px 10px}
.top .row .big{font-size:52px}
.top h2{color:#fff}
.top .muted{color:rgba(255,255,255,.88)}
.top .stats div{background:rgba(255,255,255,.2)}
.top .stats b{color:#fff}
.top .stats span{color:rgba(255,255,255,.85)}
.top .warnline{background:rgba(255,255,255,.92);color:#7a4a05}

/* карточка растения */
.dhero{position:relative;border-radius:24px;overflow:hidden;padding:20px 18px;margin-bottom:12px;min-height:150px;display:flex;
  gap:16px;align-items:center;box-shadow:var(--shadow)}
.dhero .dem{font-size:64px;line-height:1;flex:none}
.dhero .dphoto{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.dhero .dbody{position:relative}
.dhero h2{color:#fff;font-size:26px;margin:2px 0 4px}
.dhero p{margin:0;color:rgba(255,255,255,.92);font-size:15px}
.dcat{display:inline-block;font-size:12px;font-weight:600;background:rgba(255,255,255,.22);border-radius:999px;padding:3px 10px}
.card{background:var(--card);border-radius:18px;padding:16px;box-shadow:var(--shadow);margin-bottom:12px}
.card h3{margin:0 0 8px}
.card ul{margin:0;padding-left:18px}
.card li{margin-bottom:5px}
.freebadge{display:inline-block;font-size:11px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--accent);
  background:var(--accent-soft);border-radius:6px;padding:2px 7px;margin-bottom:8px}
.nums{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.nums div{background:var(--bg);border-radius:12px;padding:10px 8px}
.nums b{display:block;font-size:16px;line-height:1.2}
.nums span{font-size:12px;color:var(--muted)}
.planhead{display:flex;justify-content:space-between;align-items:center;margin:24px 0 4px}
.planhead h2{margin:0;font-size:21px}
.pill{display:inline-flex;gap:6px;align-items:center;font-size:12px;font-weight:700;border-radius:999px;padding:5px 11px;
  background:var(--warn-soft);color:var(--warn)}
.pill.ok{background:var(--accent-soft);color:var(--accent)}
.grp{margin:18px 2px 8px;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.lockrow,details.sec>summary{display:flex;gap:12px;align-items:center;width:100%;text-align:left;border:0;font:inherit;color:inherit;
  background:var(--card);border-radius:16px;padding:12px 14px;box-shadow:var(--shadow);cursor:pointer;list-style:none}
details.sec>summary::-webkit-details-marker{display:none}
.lockrow{margin-bottom:8px}
.lre{flex:none;width:38px;height:38px;border-radius:12px;background:var(--accent-soft);display:grid;place-items:center;font-size:20px}
.lockrow .lre{filter:grayscale(.6);opacity:.8}
.lrt{flex:1;min-width:0}
.lrt b{display:block;font-size:15px;line-height:1.25}
.lrt i{display:block;font-style:normal;font-size:13px;color:var(--muted);margin-top:2px}
.lockrow>.ico{color:var(--warn)}
details.sec{margin-bottom:8px}
details.sec>summary .ico{color:var(--muted);transition:transform .2s}
details.sec[open]>summary .ico{transform:rotate(180deg)}
details.sec[open]>summary{border-radius:16px 16px 0 0;box-shadow:none}
.secbody{background:var(--card);border-radius:0 0 16px 16px;padding:4px 16px 16px;box-shadow:var(--shadow)}
.secbody h4{margin:16px 0 6px;font-size:15px}
.secbody p{margin:8px 0}
.secbody ul.plain{margin:6px 0 0;padding-left:18px}
.secbody ul.plain li{margin-bottom:6px}
.promo{border-radius:20px;padding:18px;margin:18px 0 8px;background:linear-gradient(135deg,var(--accent-soft),var(--card));
  border:1px solid var(--line)}
.promo h3{margin:0 0 6px}
.promo p{margin:0 0 12px;color:var(--muted);font-size:14px}
.lnks{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 4px}
.lnk{border:1px solid var(--line);background:var(--bg);color:var(--accent);font:inherit;font-size:14px;font-weight:600;border-radius:12px;padding:9px 12px;cursor:pointer}
.src{display:flex;gap:8px;background:var(--accent-soft);border-radius:12px;padding:10px 12px;font-size:13px;margin-top:12px}
.cal{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:10px 0}
.cal div{border-radius:10px;padding:8px 4px;text-align:center;font-size:12px;line-height:1.25}
.cal b{display:block;font-size:13px}
.m-S{background:#fde7a8;color:#6b4a00}
.m-G{background:#d9ecd8;color:#24562c}
.m-H{background:#f6c3a8;color:#7a2d08}
.m-C{background:#cfe4f5;color:#174a73}
.m--{background:var(--bg);color:var(--muted)}
:root[data-theme="dark"] .m-S{background:#5a4812;color:#ffe9a8}
:root[data-theme="dark"] .m-G{background:#24402a;color:#bfe6c0}
:root[data-theme="dark"] .m-H{background:#5c2e1a;color:#ffd0b8}
:root[data-theme="dark"] .m-C{background:#1d3a52;color:#bfe0f7}
.legend{display:flex;flex-wrap:wrap;gap:6px;font-size:12px}
.legend span{border-radius:8px;padding:3px 8px}
.ch{border:1px solid var(--line);border-radius:14px;padding:12px;margin-top:10px}
.ch.fit{border-color:var(--accent);background:var(--accent-soft)}
.ch .h{display:flex;gap:8px;align-items:center;margin-bottom:4px}
.ch .h b{flex:1}
.ch .tg{font-size:11px;font-weight:700;color:var(--accent);background:var(--card);border-radius:999px;padding:2px 8px}
.ch p{margin:4px 0;font-size:14px}
.ch .k{color:var(--muted)}
.scen{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px}
.scen>div{background:var(--bg);border-radius:12px;padding:10px 8px;font-size:12px}
.scen>div.base{outline:2px solid var(--accent)}
.scen h5{margin:0 0 6px;font-size:12px;color:var(--muted)}
.scen b{display:block;font-size:14px;line-height:1.2;margin-bottom:6px}
.tpl{background:var(--bg);border-radius:12px;padding:12px;font-size:14px;white-space:pre-wrap;margin:8px 0}
.svc{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.svc:last-child{border:0}
.svc .grow{flex:1;min-width:0}
.svc b{display:block;font-size:15px}
.svc span{font-size:13px;color:var(--muted)}
.btn.small{padding:9px 14px;font-size:14px;border-radius:12px}
.textlink{border:0;background:none;color:var(--muted);font:inherit;font-size:13px;text-decoration:underline;cursor:pointer;padding:12px 0}

/* окно оплаты */
.shback{position:fixed;inset:0;background:rgba(10,20,12,.5);z-index:20;animation:fade .2s}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;max-width:560px;margin:0 auto;background:var(--bg);
  border-radius:24px 24px 0 0;padding:10px 18px calc(18px + env(safe-area-inset-bottom));max-height:92vh;overflow-y:auto;animation:up .25s}
.sheet .handle{width:40px;height:4px;border-radius:2px;background:var(--line);margin:0 auto 14px}
.sheet h2{margin:0 0 4px}
.sheet .sub{margin:0 0 14px}
.inc{display:grid;gap:8px;margin-bottom:14px}
.inc div{display:flex;gap:10px;background:var(--card);border-radius:12px;padding:10px 12px;font-size:14px}
.inc b{display:block;font-size:14px}
.inc span{color:var(--muted);font-size:13px}
.plans{display:grid;gap:8px;margin-bottom:12px}
.plan{display:flex;justify-content:space-between;gap:10px;align-items:center;width:100%;text-align:left;font:inherit;color:inherit;
  background:var(--card);border:2px solid var(--line);border-radius:16px;padding:12px 14px;cursor:pointer}
.plan.sel{border-color:var(--accent);background:var(--accent-soft)}
.plan b{display:block}
.plan span.s{font-size:13px;color:var(--muted)}
.plan .pr{font-size:18px;font-weight:700;white-space:nowrap}
.plan .tg{display:inline-block;font-size:11px;font-weight:700;background:var(--accent);color:var(--accent-ink);border-radius:999px;padding:1px 8px;margin-left:6px}
.sheet .note{font-size:12px;color:var(--muted);margin:10px 0 0;text-align:center}
.sheet .btn{width:100%}
.toast{position:fixed;left:50%;bottom:calc(90px + env(safe-area-inset-bottom));transform:translate(-50%,20px);opacity:0;pointer-events:none;
  background:#1c2a1f;color:#fff;border-radius:12px;padding:11px 16px;font-size:14px;z-index:30;transition:all .25s;max-width:86vw;text-align:center}
.toast.on{opacity:1;transform:translate(-50%,0)}
@keyframes fade{from{opacity:0}to{opacity:1}}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
</style>
</head>
<body>
<div id="app"></div>
<noscript>Для работы приложения нужен JavaScript.</noscript>
<script>
'use strict';

/* ================= Telegram ================= */
var tg = (window.Telegram && window.Telegram.WebApp) || null;

/* ================= Данные ================= */
// days — безморозный период (дней), winter — средняя температура января (°C), ориентировочно
var CITIES = [
  {id:'msk',name:'Москва',days:150,winter:-8},
  {id:'spb',name:'Санкт-Петербург',days:140,winter:-7},
  {id:'nn',name:'Нижний Новгород',days:145,winter:-10},
  {id:'kzn',name:'Казань',days:150,winter:-11},
  {id:'sam',name:'Самара',days:160,winter:-11},
  {id:'srt',name:'Саратов',days:170,winter:-9},
  {id:'vlg',name:'Волгоград',days:185,winter:-7},
  {id:'ast',name:'Астрахань',days:200,winter:-5},
  {id:'rnd',name:'Ростов-на-Дону',days:195,winter:-3},
