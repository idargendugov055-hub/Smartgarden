/* ================= Утилиты ================= */

function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function dec(n){return String(n).replace('.',',');}
function fmtNum(n){try{return new Intl.NumberFormat('ru-RU').format(n);}catch(e){return String(n);}}
function round2(n){
  if(n>=1000){var d=Math.pow(10,Math.floor(Math.log(n)/Math.LN10)-1);return Math.round(n/d)*d;}
  return Math.round(n);
}
function fmtMoney(n){
  var s=n<0?'−':'';n=Math.abs(n);
  if(n>=1e6)return s+dec(Math.round(n/1e5)/10)+' млн ₽';
  return s+fmtNum(round2(n))+' ₽';
}
function fmtKg(n){
  if(n>=1000)return dec(Math.round(n/100)/10)+' т';
  if(n<10)return dec(Math.round(n*10)/10)+' кг';
  return fmtNum(round2(n))+' кг';
}
function fmtMonths(m){
  if(!isFinite(m)||m>120)return 'более 10 лет';
  if(m<12)return '≈ '+Math.max(1,Math.round(m))+' мес.';
  return '≈ '+dec(Math.round(m/12*10)/10)+' г.';
}
function fmtArea(m2){
  if(m2>=10000)return dec(Math.round(m2/1000)/10)+' га';
  if(m2>=300)return fmtNum(Math.round(m2))+' м² ('+dec(Math.round(m2/10)/10)+' сот.)';
  return dec(Math.round(m2*10)/10)+' м²';
}
function chipLabel(space,v){
  if(space==='plot'){
    if(v>=10000)return dec(v/10000)+' га';
    return dec(v/100)+' сот.';
  }
  return v+' м²';
}
function zoneName(days){
  if(days<110)return 'очень холодный';
  if(days<130)return 'холодный';
  if(days<170)return 'умеренный';
  if(days<210)return 'тёплый';
  return 'субтропический';
}
function byId(list,id){for(var i=0;i<list.length;i++){if(list[i].id===id)return list[i];}return null;}
function toM2(val,unit){
  var v=parseFloat(String(val).replace(',','.'));
  if(!isFinite(v))return NaN;
  return unit==='га'?v*10000:unit==='сотки'?v*100:v;
}
function customCity(id){
  var c=byId(CLIMATES,id);
  return {id:'custom-'+id,name:'Другой город · '+c.name.toLowerCase()+' климат',days:c.days,winter:c.winter};
}

/* ================= Расчёт ================= */
function evalPlant(p,st,area){
  var c=st.city;
  {
    var reasons=[],warns=[],hard=false,extra=0;

    var eff=c.days+(st.space==='greenhouse'?60:0)+(st.space==='balcony'?45:0);
    var ratio=p.indoor?1.3:eff/p.needDays;
    var cf=p.indoor?1:Math.max(.6,Math.min(1,ratio));
    if(p.indoor){
      reasons.push('Растёт круглый год — погода почти не влияет');
      if(st.space==='greenhouse'&&c.winter<=-15){extra=.08;warns.push('Зимой теплицу придётся отапливать — учтено в расчёте');}
    }else if(ratio<.85){
      hard=true;warns.push('В вашем климате сезон слишком короткий для этой культуры');
    }else if(ratio<1){
      warns.push('Сезон коротковат — берите раннеспелые сорта');
      reasons.push('Подходит при выборе раннеспелых сортов');
    }else{
      reasons.push(ratio>=1.2?'Безморозный период (~'+c.days+' дн.) подходит с запасом':'Сезон в вашем городе подходит');
    }
    if(p.spaceNotes&&p.spaceNotes[st.space])reasons.push(p.spaceNotes[st.space]);

    var useArea=Math.min(area,p.maxArea),capped=area>p.maxArea;
    if(area<p.minArea){
      hard=true;warns.push('Маловато места: комфортный минимум — '+fmtArea(p.minArea));
    }else if(capped){
      reasons.push('Из '+fmtArea(area)+' под эту культуру разумно занять до '+fmtArea(p.maxArea));
    }else{
      reasons.push('Площадь '+fmtArea(area)+' подходит для этой культуры');
    }

    var yieldMul=(st.space==='greenhouse'&&!p.indoor)?1.5:(st.space==='balcony'?.8:1);
    var yearKg=useArea*p.yield*yieldMul*cf;
    var revenue=yearKg*p.price;
    var opex=revenue*(p.opex+extra);
    var profit=revenue-opex;
    var capex=useArea*p.capex;
    var payback=profit>0?capex/profit*12+p.delay*12:Infinity;

    if(st.goal==='profit'){
      reasons.push(isFinite(payback)&&payback<=36?'Окупаемость '+fmtMonths(payback):'Подходит как дополнение к основным культурам');
    }else{
      reasons.push(p.diff===1?'Простая культура — удобна для старта':'Даёт свежий урожай для семьи');
    }

    var gf=st.goal==='profit'?p.profit:p.self;
    var afit=area<p.minArea?0:Math.min(1,p.maxArea/area);
    var s=45+gf*28+(3-p.diff)*2+afit*10+cf*6;
    if(st.goal==='profit'){
      s+=payback<=12?8:payback<=24?4:0;
      if(profit<=0)s-=20;
    }
    if(hard)s-=25;

    return {p:p,score:s,match:Math.max(30,Math.min(97,Math.round(s))),hard:hard,warns:warns,reasons:reasons,
      useArea:useArea,capped:capped,yearKg:yearKg,revenue:revenue,opex:opex,profit:profit,capex:capex,payback:payback};
  }
}
function compute(st){
  var area=toM2(st.areaVal,st.areaUnit),list=[];
  for(var i=0;i<PLANTS.length;i++){
    var p=PLANTS[i];
    if(p.spaces.indexOf(st.space)<0)continue;
    list.push(evalPlant(p,st,area));
  }
  list.sort(function(a,b){return b.score-a.score;});
  var good=list.filter(function(r){return !r.hard;});
  var bad=list.filter(function(r){return r.hard;});
  return good.length>=3?good:good.concat(bad);
}

