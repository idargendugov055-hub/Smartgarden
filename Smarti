  for(var i=1;i<=5;i++)h+='<i class="'+(i<=n?'on':'')+'"></i>';
  return h+'</div><div class="stepno">Шаг '+n+' из 5</div>';
}
function bar(label){
  return '<div class="bar"><button class="btn" id="nextBtn" data-act="next"'+(canNext()?'':' disabled')+'>'+esc(label)+'</button></div>';
}
function canNext(){
  switch(state.screen){
    case 'city':return !!state.city;
    case 'space':return !!state.space;
    case 'area':var m=toM2(state.areaVal,state.areaUnit);return isFinite(m)&&m>=0.1&&m<=5000000;
    case 'goal':return !!state.goal;
  }
  return true;
}

