function copyText(txt){
  function fallback(){
    try{
      var ta=document.createElement('textarea');ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';
      document.body.appendChild(ta);ta.select();var ok=document.execCommand('copy');document.body.removeChild(ta);
      toast(ok?'Текст скопирован':'Не удалось скопировать — выделите текст вручную');
    }catch(e){toast('Не удалось скопировать — выделите текст вручную');}
  }
  try{
    if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(txt).then(function(){toast('Текст скопирован');},fallback);}
    else fallback();
  }catch(e){fallback();}
}

