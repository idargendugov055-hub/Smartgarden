  h+='<section class="card"><span class="freebadge">Бесплатно</span><h3>Что это за растение и для чего используется</h3><p>'+esc(p.about)+'</p><ul>'+
    p.use.map(function(x){return '<li>'+esc(x)+'</li>';}).join('')+'</ul></section>';

  h+='<section class="card"><span class="freebadge">Бесплатно</span><h3>Почему это подходит вам</h3><ul>'+r.reasons.map(function(x){return '<li>'+esc(x)+'</li>';}).join('')+'</ul>'+
    r.warns.map(function(w){return '<div class="warnline" style="margin-top:8px">⚠ '+esc(w)+'</div>';}).join('')+'</section>';

  h+='<section class="card"><span class="freebadge">Бесплатно</span><h3>Коротко в цифрах</h3><div class="nums">'+
    '<div><b>'+fmtMoney(r.capex*1.15)+'</b><span>на старт</span></div>'+
    '<div><b>'+fmtMoney(r.profit)+'</b><span>'+(state.goal==='profit'?'прибыль':'выгода')+' в год</span></div>'+
    '<div><b>'+(state.goal==='profit'?fmtMonths(r.payback):fmtQty(r.yearKg,p.unit))+'</b><span>'+(state.goal==='profit'?'окупаемость':'урожая в год')+'</span></div></div>'+
    '<p class="small muted" style="margin:10px 0 0">Для площади '+esc(fmtArea(r.useArea))+'. '+(open?'Подробный расчёт — в разделах ниже.':'Смета по статьям, себестоимость и сценарии — в полном плане.')+'</p></section>';

  h+='<div class="planhead"><h2>Полный план запуска</h2><span class="pill'+(open?' ok':'')+'">'+(open?'✓ Доступ открыт':ICO_LOCK.replace('width="18" height="18"','width="13" height="13"')+' 12 разделов')+'</span></div>'+
    '<p class="sub" style="margin-bottom:0">Пошаговая инструкция: от выбора семян до первых продаж.</p>';
  GROUPS.forEach(function(g){
    h+='<div class="grp">'+g.t+'</div>';
    g.ids.forEach(function(id){
      var s=byId(SECS,id);
      if(open){
        h+='<details class="sec"><summary><span class="lre">'+s.e+'</span><span class="lrt"><b>'+s.t+'</b></span>'+ICO_CHEV+'</summary><div class="secbody">'+secBody(id,r)+'</div></details>';
      }else{
        h+='<button class="lockrow" data-act="paywall" data-id="'+p.id+'"><span class="lre">'+s.e+'</span><span class="lrt"><b>'+s.t+'</b><i>'+esc(s.tz(p))+'</i></span>'+ICO_LOCK+'</button>';
      }
    });
  });

  if(open){
    h+='<section class="card" style="margin-top:20px"><h3>Нужна помощь с запуском?</h3>'+
      [['Расширенный бизнес-план','С расчётами под ваш проект'],['Консультация специалиста','Разбор вашей ситуации'],['Готовый комплект для выращивания','Всё необходимое для старта']].map(function(s){
        return '<div class="svc"><div class="grow"><b>'+s[0]+'</b><span>'+s[1]+'</span></div><button class="btn small ghost" data-act="service" data-id="'+esc(s[0])+'">'+(CONFIG.contactUrl?'Узнать':'Скоро')+'</button></div>';
      }).join('')+'</section>';
    if(CONFIG.demo)h+='<div style="text-align:center"><button class="textlink" data-act="demo-lock" data-id="'+p.id+'">Демо: снова закрыть доступ</button></div>';
  }else{
    h+='<div class="bar"><button class="btn" data-act="paywall" data-id="'+p.id+'">Открыть полный план · '+esc(CONFIG.priceOne)+'</button></div>';
  }
  return h+'<p class="foot">Расчёты ориентировочные: цены и урожайность зависят от региона, сорта и сбыта.</p>';
}

/* ---- окно оплаты ---- */
function sheetHtml(p){
  var plans=[['one','Этот план','Полный план «'+p.name+'»',CONFIG.priceOne,''],['all','Все планы','Все '+PLANTS.length+' культур, включая будущие',CONFIG.priceAll,'Выгоднее']];
  return '<div id="sheetRoot"><div class="shback" data-act="close-sheet"></div><div class="sheet" role="dialog" aria-modal="true"><div class="handle"></div>'+
    '<h2>Полный план запуска</h2><p class="sub">«'+esc(p.name)+'» — от выбора семян до первых продаж</p>'+
    '<div class="inc"><div><span>🌱</span><span><b>Вырастить</b><span>инструкция, календарь, частые ошибки</span></span></div>'+
    '<div><span>🛒</span><span><b>Запустить</b><span>где купить семена и оборудование, сборка, смета, себестоимость</span></span></div>'+
    '<div><span>💰</span><span><b>Заработать</b><span>прибыль, куда и кому продать, поиск покупателей, масштаб</span></span></div></div>'+
    '<div class="plans" id="plans">'+plans.map(function(x){
      return '<button class="plan'+(x[0]==='all'?' sel':'')+'" data-act="sheet-opt" data-id="'+x[0]+'"><span><b>'+x[1]+(x[4]?'<span class="tg">'+x[4]+'</span>':'')+'</b><span class="s">'+esc(x[2])+'</span></span><span class="pr">'+esc(x[3])+'</span></button>';
    }).join('')+'</div>'+
    '<button class="btn" id="buyBtn" data-act="buy">Открыть за '+esc(CONFIG.priceAll)+'</button>'+
    '<button class="textlink" style="width:100%" data-act="close-sheet">Не сейчас</button>'+
    (CONFIG.demo?'<p class="note">Демо-режим: оплата не подключена, доступ откроется без списания денег.</p>':'')+'</div></div>';
}
function openSheet(id){
  var p=byId(PLANTS,id);if(!p||document.getElementById('sheetRoot'))return;
  state.sheet=id;state.sheetPlan='all';
  document.getElementById('app').insertAdjacentHTML('beforeend',sheetHtml(p));
  document.body.style.overflow='hidden';
  haptic();
}
function closeSheet(){
  var s=document.getElementById('sheetRoot');
  if(s&&s.parentNode)s.parentNode.removeChild(s);
  state.sheet=null;document.body.style.overflow='';
}
function grant(plan,plantId){
  if(plan==='all')access.all=true;
  else if(access.ids.indexOf(plantId)<0)access.ids.push(plantId);
  saveAccess();closeSheet();render(false);toast('Доступ открыт');
}
function buy(plan,plantId){
  if(CONFIG.invoiceEndpoint){
    try{
      fetch(CONFIG.invoiceEndpoint,{method:'POST',headers:{'Content-Type':'application/json'},
        body:JSON.stringify({plan:plan,plant:plantId,initData:(tg&&tg.initData)||''})})
        .then(function(r){return r.json();})
        .then(function(d){
          if(tg&&tg.openInvoice&&d&&d.link){tg.openInvoice(d.link,function(status){if(status==='paid')grant(plan,plantId);});}
          else toast('Не удалось открыть оплату');
        })
        .catch(function(){toast('Не удалось открыть оплату');});
    }catch(e){toast('Не удалось открыть оплату');}
  }else if(CONFIG.demo){
    grant(plan,plantId);
  }else{
    toast('Оплата пока не подключена');
  }
}
function extraAct(act,id,el){
  switch(act){
    case 'cat':state.cat=id;state.showAll=false;render(false);break;
    case 'showall':state.showAll=true;render(false);break;
    case 'paywall':haptic();openSheet(id||state.detailId);break;
    case 'close-sheet':closeSheet();break;
    case 'sheet-opt':
      state.sheetPlan=id;
      var opts=document.querySelectorAll('#plans .plan');
      for(var i=0;i<opts.length;i++)opts[i].classList.toggle('sel',opts[i].getAttribute('data-id')===id);
      var b=document.getElementById('buyBtn');
      if(b)b.textContent='Открыть за '+(id==='all'?CONFIG.priceAll:CONFIG.priceOne);
      haptic();break;
    case 'buy':buy(state.sheetPlan,state.sheet);break;
    case 'demo-lock':
      access.all=false;access.ids=[];saveAccess();render(false);toast('Доступ закрыт (демо)');break;
    case 'link':openUrl(el.getAttribute('data-url'));break;
    case 'copy':copyText(el.getAttribute('data-text')||'');break;
    case 'service':
      if(CONFIG.contactUrl)openUrl(CONFIG.contactUrl);else toast('Скоро будет доступно');break;
  }
}

/* ================= Рендер ================= */
function render(toTop){
  var app=document.getElementById('app');
  if(state.sheet){state.sheet=null;document.body.style.overflow='';}
  var h;
  if(state.detailId)h=viewDetail();
  else switch(state.screen){
    case 'intro':h=viewIntro();break;
    case 'city':h=viewCity();break;
    case 'space':h=viewSpace();break;
    case 'area':h=viewArea();break;
    case 'goal':h=viewGoal();break;
    case 'analyze':h=viewAnalyze();break;
    default:h=viewResult();
  }
  app.innerHTML=h;
  if(!state.detailId){
    if(state.screen==='city'){fillCityList();fillCityInfo();}
    if(state.screen==='area')fillAreaHint();
  }
  updateBack();
  if(toTop)window.scrollTo(0,0);
}

/* ================= Навигация ================= */
function go(screen){state.screen=screen;render(true);}
function back(){
  if(state.sheet){closeSheet();return;}
  if(state.detailId){closeDetail();return;}
  var i=ORDER.indexOf(state.screen);
  if(state.screen==='result'||state.screen==='analyze'){analysisRun++;state.screen='goal';}
  else if(i>0)state.screen=ORDER[i-1];
  render(true);
}
function closeDetail(){
  state.detailId=null;
  render(false);
  window.scrollTo(0,state.scrollY||0);
}
function next(){
  if(!canNext())return;
  switch(state.screen){
    case 'city':go('space');break;
    case 'space':go('area');break;
    case 'area':go('goal');break;
    case 'goal':startAnalysis();break;
  }
}

/* ================= События ================= */
function init(){
  var app=document.getElementById('app');
  app.addEventListener('click',function(e){
    var el=e.target.closest?e.target.closest('[data-act]'):null;
    if(!el)return;
    var act=el.getAttribute('data-act'),id=el.getAttribute('data-id');
    switch(act){
      case 'start':haptic();go('city');break;
      case 'next':haptic();next();break;
      case 'pick-city':
        state.city=byId(CITIES,id);state.cityOther=false;save();haptic();
        fillCityList();fillCityInfo();updateNext();break;
      case 'other-city':
        state.cityOther=true;
        if(state.city&&String(state.city.id).indexOf('custom-')!==0)state.city=null;
        haptic();fillCityList();fillCityInfo();updateNext();break;
      case 'pick-climate':
        state.city=customCity(id);state.cityOther=true;save();haptic();
        fillCityList();fillCityInfo();updateNext();break;
      case 'pick-space':state.space=id;save();haptic();render(false);break;
      case 'pick-goal':state.goal=id;save();haptic();render(false);break;
      case 'chip':
        var v=parseFloat(el.getAttribute('data-m2'));
        if(state.space==='plot'&&v>=10000){state.areaUnit='га';state.areaVal=dec(v/10000);}
        else if(state.space==='plot'){state.areaUnit='сотки';state.areaVal=dec(v/100);}
        else{state.areaUnit='м²';state.areaVal=String(v);}
        save();haptic();
        var inp=document.getElementById('areaInput'),sel=document.getElementById('areaUnit');
        if(inp)inp.value=state.areaVal;
        if(sel)sel.value=state.areaUnit;
        fillAreaHint();updateNext();break;
      case 'open':
        state.scrollY=window.scrollY||0;state.detailId=id;state.tab='use';haptic();render(true);break;
      case 'close-detail':closeDetail();break;
      default:extraAct(act,id,el);break;
      case 'tab':state.tab=id;haptic();render(false);break;
      case 'edit':analysisRun++;go('city');break;
      case 'restart':
        analysisRun++;state.city=null;state.cityOther=false;state.q='';state.space=null;state.areaVal='';state.areaUnit='м²';state.goal=null;
        state.results=null;state.detailId=null;save();go('intro');break;
    }
  });
  app.addEventListener('input',function(e){
    var t=e.target;
    if(t.id==='citySearch'){state.q=t.value;fillCityList();}
    else if(t.id==='areaInput'){state.areaVal=t.value;save();fillAreaHint();updateNext();}
  });
  app.addEventListener('change',function(e){
    if(e.target.id==='areaUnit'){state.areaUnit=e.target.value;save();fillAreaHint();updateNext();}
  });

  try{
    if(tg){
      tg.ready();
      if(tg.expand)tg.expand();
      if(tg.disableVerticalSwipes)tg.disableVerticalSwipes();
      if(tg.onEvent)tg.onEvent('themeChanged',applyTheme);
      if(tg.BackButton)tg.BackButton.onClick(back);
    }
  }catch(err){}
  applyTheme();
  load();
  loadAccess();
  render(true);
}
init();
</script>
</body>
</html>
